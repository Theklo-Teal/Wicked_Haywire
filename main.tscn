[sub_resource type="GDScript" id="GDScript_272bh"]
script/source = "extends ColorRect

# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(_delta: float) -> void:
	if visible:
		queue_redraw()

func _draw() -> void:
	var line : PackedVector2Array
	var step = 10
	var span = 0
	while span < size.x + step:
		var freq1 = remap(Time.get_ticks_msec() * 0.1 + span, 0, 1000, 0, PI * 7)
		var freq2 = remap(Time.get_ticks_msec() * 0.2 + span, 0, 1000, 0, PI * 25)
		var freq = sin(freq1) * size.y * 0.2 + sin(freq2) * size.y * 0.25
		var y = freq + size.y * 0.5
		line.append(Vector2(span, y))
		span += step
	draw_polyline(line, Color.REBECCA_PURPLE, 3)
"

