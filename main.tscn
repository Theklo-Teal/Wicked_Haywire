[sub_resource type="GDScript" id="GDScript_0xm2m"]
script/source = "extends Node

#TODO Mode button switches visibility of Component tray versus Analyser tray, so components can't be placed during simulation mode.
#TODO Sidebar resize stored in settings
#TODO Trace Colors in Layer Options

@export_storage var split_container = 180 : 
	set(val):
		split_container = val
		if not is_node_ready():
			await ready
			%TraySplitter.split_offsets[0] = val

func _ready() -> void:
	var lang = G.setts.get_value(\"0\", \"language\", \"\")
	lang = lang if lang in LANG else OS.get_locale_language()
	lang = lang if lang in LANG else \"en\"
	TranslationServer.set_locale(lang)
	%Language.select(LANG.find(lang))
	
	%TrayTabBar.current_tab = G.setts.get_value(\"0\", \"ribbonbar\", 0)
	%Ribbon/TabContainer.current_tab = G.setts.get_value(\"0\", \"ribbonbar\", 0)
	print()
	if %Ribbon/TabContainer.current_tab < 0:
		%Ribbon.hide()
	
	find_flowchart_themes()
	find_electronics_parts()

func _input(event: InputEvent) -> void:
	if event is InputEventKey and event.is_released():
		match event.keycode:
			KEY_F1:
				%Mode.button_pressed = not %Mode.button_pressed
			KEY_ESCAPE:
				var grab_part = G.grabbed_buttons.get_pressed_button()
				if not grab_part == null:
					grab_part.button_pressed = false
					return

#region Ribbon/Tray

func _on_tray_tab_bar_tab_changed(tab: int, tabbar: TabBar) -> void:
	G.setts.set_value(\"0\", \"ribbonbar\", tab)
	if tab < 0:
		%Ribbon.hide()
	else:
		%Ribbon.show()
		var tabtitle = tabbar.get_tab_title(tab)
		%Ribbon/TabContainer.find_child(tabtitle, false).show()

#region Layer Options
func _on_add_layer_pressed() -> void:
	%Scheme_Layers.add_tab(%Layer_Title.text)

const THEME_PATH = \"res://styles/flowchart/\"
@onready var theme_list : PopupMenu = %Theme_Select.get_popup()
var theme_ids : Dictionary[String, int]
func find_flowchart_themes():
	theme_list.clear()
	if not theme_list.index_pressed.is_connected(_on_flowchart_theme_picked):
		theme_list.index_pressed.connect(_on_flowchart_theme_picked)
	for each in DirAccess.get_files_at(THEME_PATH):
		if each.get_extension() != \"tres\":
			continue
		var id = hash(THEME_PATH + each)
		theme_list.add_item(each.get_basename(), id)
		var idx = theme_list.get_item_index(id)
		theme_list.set_item_metadata(idx, THEME_PATH + each)
		theme_ids[each.get_basename()] = id
	_on_flowchart_theme_picked(0)

func _on_flowchart_theme_picked(idx:int):
	%Theme_Title.text = theme_list.get_item_text(idx)
	var theme : FlowchartStyle = load(theme_list.get_item_metadata(idx))
	G.appearance = theme
	%Cell_Size.value = theme.cell_size
	%Back_Color.color = theme.color
	%Orig_Thick.value = theme.orig_thick
	%Orig_Color.color = theme.orig_color
	%Grid_Thick.value = theme.grid_thick
	%Grid_Color.color = theme.grid_color

func _on_save_theme_pressed() -> void:
	var idx = theme_list.get_item_index(theme_ids[%Theme_Title.text])
	ResourceSaver.save(%Flowchart.appearance, theme_list.get_item_metadata(idx))

func _on_rem_theme_pressed() -> void:
	var title = %Theme_Title.text
	if title in [\"Blueprint\", \"Dark_CAD\"]:
		# Don't delete the default themes
		return
	var idx = theme_list.get_item_index(theme_ids[title])
	var path = theme_list.get_item_metadata(idx)
	var error = DirAccess.remove_absolute(path)
	if error != OK:
		printerr(\"Main/_on_rem_theme_pressed: Problem removing theme! Error: \" + error_string(error) + \"; Theme: \" + path)
	theme_list.remove_item(idx)
	_on_flowchart_theme_picked(0)
	
func _on_dupl_theme_pressed() -> void:
	pass

@warning_ignore_start(\"narrowing_conversion\")
func _on_cell_size_value_changed(value: float) -> void:
	G.appearance.cell_size = value
func _on_back_color_color_changed(color: Color) -> void:
	G.appearance.color = color
func _on_orig_thick_value_changed(value: float) -> void:
	G.appearance.orig_thick = value
func _on_orig_color_color_changed(color: Color) -> void:
	G.appearance.orig_color = color
func _on_grid_thick_value_changed(value: float) -> void:
	G.appearance.grid_thick = value
func _on_grid_color_color_changed(color: Color) -> void:
	G.appearance.grid_color = color
@warning_ignore_restore(\"narrowing_conversion\")
#endregion

#region Electronics Components Tray

func find_electronics_parts():
	const dev_path = \"res://gizmos/\"
	for dev_category : String in parts_categories:
		var open_button := Button.new()
		parts_categories[dev_category].append(open_button)
		
		open_button.text = dev_category.to_upper()
		open_button.pressed.connect(_on_part_category_toggle.bind(dev_category, true))
		
		%part_categories.add_child(open_button)
		
		var box := VBoxContainer.new()
		var close_button := Button.new()
		var innerbox := VFlowContainer.new()
		parts_categories[dev_category].append(close_button)
		parts_categories[dev_category].append(box)
		
		box.size_flags_vertical = Control.SIZE_EXPAND_FILL
		close_button.text = dev_category.to_upper()
		close_button.size_flags_horizontal = Control.SIZE_SHRINK_BEGIN
		innerbox.size_flags_vertical = Control.SIZE_EXPAND_FILL
		innerbox.add_theme_constant_override(\"v_separation\", 0)
		box.hide()
		
		close_button.pressed.connect(_on_part_category_toggle.bind(dev_category, false))
		
		%Components.add_child(box)
		box.add_child(close_button)
		box.add_child(innerbox)
		for dev in DirAccess.get_files_at(dev_path.path_join(dev_category)):
			if dev.get_extension() == \"uid\":
				continue
			var full_path = dev_path.path_join(dev_category).path_join(dev)
			#var part = load(full_path) #TODO load all components at start up.
			#G.part_pallet.append(part)
			var dev_button := Button.new()
			dev_button.text = dev.get_basename().to_upper()
			dev_button.set_meta(\"path\", full_path)
			#dev_button.set_meta(\"refer\", part)
			dev_button.flat = true
			dev_button.toggle_mode = true
			dev_button.button_group = G.grabbed_buttons
			innerbox.add_child(dev_button)

var parts_categories = {
	\"misc\" : [],
	\"input\" : [],
#	\"output\" : [],
	\"checks\" : [],
#	\"arithmetic\" : [],
#	\"plexers\" : [],
#	\"memory\" : [],
	}

func _on_part_category_toggle(category:String, show:bool):
	parts_categories[category][0].visible = not show
	parts_categories[category][1].visible = show
	parts_categories[category][2].visible = show

func _on_fold_devices_toggled(toggled_on: bool, butt:Button) -> void:
	butt.text = tr([\"UNFOLD_ALL\", \"FOLD_ALL\"][int(toggled_on)])
	for category in parts_categories:
		_on_part_category_toggle(category, toggled_on)
#endregion

#endregion

func _on_sidebar_button_toggled(toggled_on: bool) -> void:
	%Sidebar.visible = toggled_on

func _on_sim_paused_toggled(toggled_on: bool, butt:Button) -> void:
	butt.text = tr([\"PAUSED\", \"RUNNING\"][int(toggled_on)])
	butt.modulate = [Color.RED, Color.LIME_GREEN][int(toggled_on)]
	%Flowchart.call([\"pause_sim\", \"resume_sim\"][int(toggled_on)])


func _on_sim_rate_item_selected(index: int, butt:OptionButton) -> void:
	var hz = butt.get_item_id(index) as float
	%Flowchart.update_rate = 1.0 / hz


#region Schematic Layers
func scheme_add_layer(title:String=\"\"):
	if title.is_empty():
		title = tr(\"LAYER\") + \"_\" + str(%Scheme_Layers.tab_count)
	%Scheme_Layers.add_tab(title)

var scheme_layer_delete_target : String
func _on_scheme_layers_tab_close_pressed(tab: int) -> void:
	scheme_layer_delete_target = %Scheme_Layers.get_tab_title(tab)
	if Input.is_key_pressed(KEY_CTRL):
		scheme_rem_layer()
	else:
		$Confirm_Rem_Layer.dialog_text = \"Are you sure you want to delete layer «\" + scheme_layer_delete_target + \"»?\"
		$Confirm_Rem_Layer.popup()
func scheme_rem_layer(target:String=\"\"):
	if target.is_empty():
		target = scheme_layer_delete_target
	var target_idx : int = -1
	for i in range(%Scheme_Layers.tab_count):
		if %Scheme_Layers.get_tab_title(i):
			target_idx = i
			break
	
	if target_idx > 0:
		%Scheme_Layers.remove_tab(target_idx)
	
	if %Scheme_Layers.tab_count == 0:
		scheme_add_layer(tr(\"LAYER_ZERO\"))
#endregion


func _on_tray_splitter_drag_ended(splitter: SplitContainer) -> void:
	split_container = splitter.split_offsets[0]


func _on_mode_toggled(toggled_on: bool, button:Button) -> void:
	%Flowchart.mode = int(toggled_on) as Flowchart.Mode
	button.text = [tr(\"PLACE\"), tr(\"POKE\")][int(toggled_on)]

const LANG = [\"en\", \"eo\", \"pt\"]
func _on_language_item_selected(index: int) -> void:
	G.setts.set_value(\"0\", \"language\", LANG[index])
	TranslationServer.set_locale(LANG[index])
"

