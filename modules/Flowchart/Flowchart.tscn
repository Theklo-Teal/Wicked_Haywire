[sub_resource type="GDScript" id="GDScript_x8yhq"]
resource_name = "FlowchartInputFSM"
script/source = "extends Node

var mode : StringName = \"idle\"
@onready var modes := {
	\"idle\":IdleMode.new(get_parent(), get_parent().get_node(\"Network\"), set_mode),
	\"via\":WireMode.new(get_parent(), get_parent().get_node(\"Network\"), set_mode),
	\"wire\":WireMode.new(get_parent(), get_parent().get_node(\"Network\"), set_mode),
	}

func at(who:String):
	return who == mode

func now() -> InputMode:
	return modes[mode]

func set_mode(next:StringName):
	now().exit()
	mode = next
	now().enter()

@warning_ignore_start(\"unused_parameter\")
class InputMode:
	var me : Flowchart
	var switch : Callable
	var net : FlowchartNetwork
	func _init(this:Flowchart, network:FlowchartNetwork, switcher:Callable) -> void:
		me = this
		switch = switcher
		net = network
	func cancel():
		switch.call(\"idle\")
	
	func grid_mouse() -> Vector2i:
		return Flowchart.to_grid(me.to_canvas_coord(me.get_local_mouse_position()))
	func canvas_mouse() -> Vector2:
		return me.to_canvas_coord(me.get_local_mouse_position())
	func screen_mouse() -> Vector2:
		return me.get_local_mouse_position()
	
	func mouse_over_vert():
		var cell = grid_mouse()
		cell = Vector3i(cell.x, cell.y, me.layer)
		me.sel_vert = net.netlist.vias.get(cell)
	
	func mouse_over_wire():
		var conns : PackedInt64Array
		for via in me.parti.joint.find_objects_simple(me._view_rect):
			conns.append_array(net.netlist.get_links(via, true, false))
		for link in conns:
			var wire = net.netlist.links[link]
			var pair = net.netlist.pairs[link]
			var pos1 = Flowchart.from_grid(pair[0].coord)
			var pos2 = Flowchart.from_grid(pair[2].coord)
			me.sel_wire = wire.near(canvas_mouse(), pos1, pos2)
			if not me.sel_wire.is_empty(): break
	
	func enter():
		pass
	func exit():
		pass
	
	func mouse_move(left:bool, right:bool, shift:bool, ctrl:bool):
		pass
	
	func mouse_press(button:MouseButton, shift:bool, ctrl:bool):
		pass
	func mouse_release(button:MouseButton, shift:bool, ctrl:bool):
		pass
@warning_ignore_restore(\"unused_parameter\")


class IdleMode extends InputMode:
	func enter():
		me.move_obj_allowed = true
		me.lasso_allowed = true
		me.wiring_allowed = true
	
	func mouse_press(button:MouseButton, _shift:bool, _ctrl:bool):
		match button:
			MOUSE_BUTTON_LEFT:
				mouse_over_vert()
				if me.sel_vert == null:
					mouse_over_wire()
					if not me.sel_wire.is_empty() and me.wiring_allowed:
						pass
						#switch.call(\"wire\")
				else:
					pass
					#switch.call(\"via\")
				
			MOUSE_BUTTON_RIGHT:
				mouse_over_vert()
				if me.sel_vert == null:
					mouse_over_wire()
					if me.sel_wire.is_empty():
						me.add_gizmo(\"bogus\", canvas_mouse())
						#me.get_node(\"Canvas_Menu\").popup(Rect2(screen_mouse(), Vector2.ZERO))
				else:
					#TODO Show via menu
					pass
	
	func mouse_release(button:MouseButton, _shift:bool, _ctrl:bool):
		if button == MOUSE_BUTTON_LEFT and me.lasso_canvas_rect.size > Flowchart.MINIMUM_LASSO:
			if me.lasso_allowed:
				#TODO Find out why lasso_mode doesn't change.
				if me.lasso_mode:
					me._selected += me.parti.node.find_objects_tolerant(me.lasso_canvas_rect)
				else:
					me._selected += me.parti.node.find_objects_zealous(me.lasso_canvas_rect)


class ViaMode extends InputMode:
	func mouse_move(left:bool, right:bool, shift:bool, ctrl:bool):
		pass

class WireMode extends InputMode:
	func enter():
		print(\"wiring\")
		me.move_obj_allowed = false
		me.lasso_allowed = false
		
		var cell = grid_mouse()
		var via = net.netlist.vias.get(Vector3i(cell.x, cell.y, me.layer), null)
		if via != null:
			me.start_via_wiring({
				\"netvert\": via,
				\"canvas_position\": cell,
				})
	
	func mouse_move(left:bool, right:bool, _shift:bool, _ctrl:bool):
		if me.wire_from.is_empty(): return
		if not(left and right): return
		me.queue_redraw()
	
	func mouse_release(button:MouseButton, _shift:bool, _ctrl:bool):
		if button == MOUSE_BUTTON_LEFT:
			me.stop_canvas_wiring(grid_mouse())
		switch.call(\"idle\")
"

