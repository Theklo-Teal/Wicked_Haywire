[gd_scene format=3 uid="uid://cs1lu7qijhrk5"]

[sub_resource type="GDScript" id="GDScript_uhamo"]
script/source = "extends HBoxContainer

signal load_scheme(scheme:FlowchartNetwork.NetData)

var title : String : 
	set(val):
		title = val
		$Title.text = val
var metadat : String
var netlist : String

func _on_load_pressed() -> void:
	var scheme = load(netlist)
	load_scheme.emit(scheme)

func _on_delete_pressed() -> void:
	OS.move_to_trash(netlist)
	OS.move_to_trash(metadat)
"

[node name="Scheme_Entry" type="HBoxContainer" unique_id=308704527]
