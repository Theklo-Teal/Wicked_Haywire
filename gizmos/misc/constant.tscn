[sub_resource type="GDScript" id="GDScript_byh3h"]
script/source = "@tool
extends Electronics

static func toybox_included() -> bool:
	return false

@export var value : int = 1

var sock : BitOutput


func _ready() -> void:
	#TODO add `sockets`.
	#TODO add `description`
	#TODO set `options`
	#TODO set `dwell` and `delay`
	
	sock = sockets.keys()[0]

func _update_layout():
	match facing:
		pass

func _sim_update(graph:FlowchartNetwork):
	var negat = (1 << bitwidth - 1) ^ value
	sock.write(value, \"pull_up\", bitwidth)
	sock.write(negat, \"pull_down\", bitwidth)
"

