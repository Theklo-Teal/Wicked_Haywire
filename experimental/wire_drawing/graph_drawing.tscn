[sub_resource type="GDScript" id="GDScript_u6phq"]
script/source = "extends Control

#TODO Ensure no wires are created where there is already a connection.
#TODO Allow cycling selection through overlapping wires.
#TODO Create wire from a socket, to empty space.
#TODO Create wire from socket to socket.
#TODO Wire deletion
#TODO Wire detach
#TODO Wire split
#TODO Wire join
#TODO Wire shifting (tentative)
#TODO Wire merge (tentative)
#TODO Check if wires adapt their shape to changes in neighbors

var net := xNetwork.new()

func _ready() -> void:
	net.connections_changed.connect(func():queue_redraw())
	for i in range(20):
		var coord = Vector2i(15, i + 5)
		var sock = xSocket.new()
		sock.mode = xSocket.INPUT if i % 2 == 0 else xSocket.OUTPUT
		net.get_or_add_joint(X.from_grid(coord), X.layer,sock)

func _mouse_over_joint(where:Vector2):
	var cell = X.to_grid(where).coord
	cell = Vector3i(cell.x, cell.y, X.layer)
	X.coord_joint = cell
	X.sel_joint = net.netlist.joints.get(cell)

func _mouse_over_wire(where:Vector2):
	X.info_wire = net.over_wire(where, X.layer)
	if not X.info_wire.is_empty():
		X.sel_wire = X.info_wire.wire
		X.info_wire[\"bend\"] = X.sel_wire.bend

func _resize_bend(wire:xNetBase.xWire, ini_bend:float, ini_pos:Vector2, end_pos:Vector2):
		var verts = wire.get_verts()
		var short_vert = wire.get_segment_is(false)
		var rect = wire.get_rect()
		var axis = rect.size.min_axis_index()
		var dir = 1 if ini_pos[axis] > verts[short_vert][axis] else -1
		var delta = end_pos - ini_pos
		var dist : float = delta.length() * delta.sign()[axis] * dir * 2
		dist /= rect.size[axis]
		wire.bend = clamp(ini_bend + dist, 0, 1) 

func _new_wire(release:Vector2, ini_joint:xNetBase.xJoint, ini_wire:xNetBase.xWire, ini_ending:xNetBase.xWire.VERT, fin_ending:xNetBase.xWire.VERT):
	#NOTE This function won't be called if both ini_joint or ini_wire are null.
	var alternate : bool = Input.is_key_pressed(KEY_SHIFT)
	var wire = xNetBase.xWire.new()
	
	if X.sel_joint == null and X.sel_wire == null:
		# Finished dragging on empty space
		X.sel_joint = net.get_or_add_joint(release, X.layer, xNetBase.xVia.new())
	
	if ini_joint is xNetBase.xVia and ini_joint.text.is_empty() and ini_joint.connected.size() == 1:
		# Delete ini_joint and attach new wire to another wire.
		ini_wire = ini_joint.connected[0]
		ini_ending = ini_wire.get_ending(ini_joint)
		ini_joint = null
		#TODO delete ini_joint
	
	var start : Vector2
	var stop : Vector2
	if ini_joint != null:
		# Started from a joint
		start = ini_joint.position
		net.plug_wire(wire, ini_joint, xNetBase.xWire.VERT.ORIGIN)
	elif ini_wire != null:
		# Started from a wire
		# net.split_wire(ini_wire)
		start = ini_wire.get_vertex_position(ini_ending)
		net.extend_wire(ini_wire, wire, ini_ending, xNetBase.xWire.VERT.ORIGIN)
	
	if X.sel_joint != null:
		# Finished on a joint
		stop = X.sel_joint.position
		net.plug_wire(wire, ini_joint, xNetBase.xWire.VERT.ORIGIN)
	elif X.sel_wire != null:
		# Finished on a wire
		# net.split_wire(X.sel_wire)
		stop = X.sel_wire.get_vertex_position(fin_ending)
		net.extend_wire(X.sel_wire, wire, fin_ending, xNetBase.xWire.VERT.ENDING)
	
	wire.set_length(start, stop, alternate)


var start_drag : Vector2
var was_drag : bool
func _gui_input(event: InputEvent) -> void:
	if event is InputEventKey and not event.is_echo():
		match event.keycode:
			KEY_DELETE:
				if X.sel_wire != null:
					# Delete wire selected.
					pass
			KEY_ESCAPE:
				if was_drag and X.sel_wire != null:
					# Delete wire being pulled.
					pass
	
	if event is InputEventMouseMotion:
		if Input.is_mouse_button_pressed(MOUSE_BUTTON_LEFT) or Input.is_mouse_button_pressed(MOUSE_BUTTON_RIGHT):
			was_drag = true
		if Input.is_mouse_button_pressed(MOUSE_BUTTON_RIGHT) and was_drag:
			if X.sel_joint != null and not X.sel_joint is xSocket:
				pass
			elif not X.sel_wire == null:
				if floor(X.info_wire.subratio) == 1:  # Clicked on Bend
					_resize_bend(X.sel_wire, X.info_wire.bend, start_drag, event.position)
				#else:
					## Detach Wire
					#if segm_info.subratio < 1:
						#ref_segm.ori_position = event.position
					#else:
						#ref_segm.end_position = event.position
	
	if event is InputEventMouseButton and event.button_index in [MOUSE_BUTTON_LEFT, MOUSE_BUTTON_RIGHT]:
		if event.is_pressed():
			queue_redraw()
			start_drag = event.position
			X.sel_wire = null
			X.sel_joint = null
			_mouse_over_joint(event.position)
			if X.sel_joint == null:
				# If not pressing over a joint, select a wire.
				_mouse_over_wire(event.position)
				X.detach_wire = false
				if X.sel_wire != null:  # A segment was found and selected
					if event.button_index == MOUSE_BUTTON_RIGHT:
						if floor(X.info_wire.subratio) != 1:  # Not clicking on a bend.
							X.detach_wire = true
		elif event.is_released():
			if was_drag:
				was_drag = false
				queue_redraw()
				match event.button_index:
					MOUSE_BUTTON_LEFT:
						var sel_joint := X.sel_joint
						var sel_wire := X.sel_wire
						var ini_ending := xNetBase.xWire.VERT.MIDDLE
						if not X.info_wire.is_empty():
							ini_ending = xNetBase.xWire.VERT.ORIGIN if X.info_wire.ratio < 0.5 else xNetBase.xWire.VERT.ENDING
						
						if not (sel_joint == null and sel_wire == null):
							_mouse_over_joint(event.position)
							_mouse_over_wire(event.position)
							var fin_ending := xNetBase.xWire.VERT.MIDDLE
							if not X.info_wire.is_empty():
								fin_ending = xNetBase.xWire.VERT.ORIGIN if X.info_wire.ratio < 0.5 else xNetBase.xWire.VERT.ENDING
							if not ((sel_joint == X.sel_joint and sel_joint != null) or (sel_wire == X.sel_wire and sel_wire != null)):
								_new_wire(event.position, sel_joint, sel_wire, ini_ending, fin_ending)
						
					MOUSE_BUTTON_RIGHT:
						# Move Joint
						if X.sel_joint != null and not X.sel_joint is xSocket:
							net.move_joint(X.sel_joint, event.position)


func _draw() -> void:
	# Draw stuff on the netlist
	for coord in net.netlist.joints:
		if coord.z != X.layer:
			continue
		var joint = net.netlist.joints[coord]

		joint.draw(self, joint == X.sel_joint)
	for wire in net.netlist.wires.get(X.layer, []):
		if wire == X.sel_wire and X.detach_wire: continue
		wire.draw(self, wire == X.sel_wire)

var period : float = 0.33
var _elapsed : float = 0
func _process(delta: float) -> void:
	_elapsed += delta
	if _elapsed > period:
		_elapsed = 0
		net.setup_cycle()
		net.setup_cycle()
		net.finish_cycle()
"

[sub_resource type="GDScript" id="GDScript_08qwr"]
script/source = "extends Control


func _gui_input(event: InputEvent) -> void:
	if event is InputEventMouseMotion: queue_redraw()
	
	if event is InputEventMouseButton:
		if get_parent().was_drag and event.is_released():
			queue_redraw()
	
	if event is InputEventKey and not event.is_echo():
		match event.keycode:
			KEY_SHIFT:
				if get_parent().was_drag:
					# Change the orientation of wire being created.
					queue_redraw()


func _draw() -> void:
	# Cell Highlight
	var clr = Color.WHITE
	clr.a = 0.3
	var grid = X.to_grid(get_local_mouse_position())
	draw_circle(grid.position, X.CELL_RAD, clr)

	# Wire being pulled
	if get_parent().was_drag and X.sel_joint != null and Input.is_mouse_button_pressed(MOUSE_BUTTON_LEFT):
		var start = X.from_grid(Vector2i(X.coord_joint.x, X.coord_joint.y))
		var stop = X.to_grid(get_local_mouse_position()).position
		var rect = Rect2(start, stop - start)
		xNetBase.xWire.draw_length(self, rect, Input.is_key_pressed(KEY_SHIFT), Color.YELLOW)
	
	#Joint being moved
	if get_parent().was_drag and X.sel_joint != null and not X.sel_joint is xSocket and Input.is_mouse_button_pressed(MOUSE_BUTTON_RIGHT):
		@warning_ignore(\"static_called_on_instance\")
		X.sel_joint.draw_at(self, get_global_mouse_position(), Color.YELLOW)
	
"

