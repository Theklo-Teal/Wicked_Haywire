[node name="Label" type="RichTextLabel" parent="MarginContainer" unique_id=618982696]
layout_mode = 2
mouse_filter = 2
text = "Click and drag from an existing Socket to start a wire.

The wire can be released on empty space, creating a Joint, from which other wires can be created.

The shape of the wire can be alternated by holding the SHIFT key.

Dragging from the diagonal corner of a wire allows that diagonal to be resized.

Clicking wires or sockets allows them to be deleted with the \"Delete\" key.

The Right Mouse Button can be used to move joints to different coordinates.

Joints can never overlap."
autowrap_mode = 2
